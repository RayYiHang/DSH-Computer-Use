        "darwin"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RayYiHang/DSH-Computer-Use.git"
  },
  "files": [
    "plugin.mjs",
    "runtime.mjs",
    "cordis.patch.yml",
    "README.md"
  ]
}
