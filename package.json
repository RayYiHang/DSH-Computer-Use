{
  "name": "dsh-chatgpt-computer-use",
  "version": "1.2.0",
  "description": "Use the local ChatGPT Computer Use runtime from a DSH agent on macOS.",
  "private": true,
  "type": "module",
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./preview/client.js"
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RayYiHang/DSH-Computer-Use.git"
  },
  "files": [
    "plugin.mjs",
    "runtime.mjs",
    "cordis.patch.yml",
    "README.md",
    "preview/index.mjs",
    "preview/sky.mjs",
    "preview/client.js",
    "preview/companion.mjs",
    "preview/bin/"
  ],
  "scripts": {
    "build:preview": "sh preview/build.sh"
  }
}
