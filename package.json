{
  "name": "dsh-chatgpt-computer-use",
  "version": "1.1.0",
  "description": "Use the local ChatGPT Computer Use runtime from a DSH agent on macOS.",
  "private": true,
  "type": "module",
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
